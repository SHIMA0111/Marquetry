#: ../../export/onnx_export.rst:3
msgid "ONNX Export"
msgstr ""

#: ../../export/onnx_export.rst:5
msgid ""
"Export a model as an `ONNX <https://onnx.ai/>`_ inference graph. This "
"feature requires the ``onnx`` package (``pip install "
"\"marquetry[onnx]\"``), and the exported model can be verified or "
"executed with `ONNX Runtime <https://onnxruntime.ai/>`_."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:1 of
msgid "Export a model to an ONNX inference graph."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:3 of
msgid ""
"Runs one forward pass with the sample inputs in test mode, walks the "
"recorded computation graph, and converts every traced function to ONNX "
"operators. The produced model is pinned to ``opset_version`` and IR "
"version 10 so that it stays loadable by widely deployed ONNX Runtime "
"versions."
msgstr ""

#: ../../export/onnx_export.rst
msgid "Parameters"
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:8 of
msgid "The model to export."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:10 of
msgid ""
"A sample input array (or :class:`marquetry.Container`), or a tuple/list "
"of them for multi-input models. The traced graph is specialized to these "
"shapes (except the batch axis)."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:13 of
msgid "If given, the model is also serialized to this path."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:15 of
msgid "Target opset of the default ONNX domain. Defaults to 21."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:17 of
msgid ""
"If True, the leading axis of every graph input/output is exported as a "
"symbolic ``batch_size`` dimension."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:20 of
msgid "Names for the graph inputs."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:22 of
msgid "Names for the graph outputs."
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:24 of
msgid "If True, run ``onnx.checker.check_model`` on the result."
msgstr ""

#: ../../export/onnx_export.rst
msgid "Returns"
msgstr ""

#: marquetry.onnx_export.exporter.export_onnx:27 of
msgid "The exported model."
msgstr ""

#: ../../export/onnx_export.rst
msgid "Return type"
msgstr ""

#: marquetry.onnx_export.converters.ONNXExportError:1 of
msgid ""
"Raised when a model contains a computation which can't be expressed in "
"ONNX."
msgstr ""

