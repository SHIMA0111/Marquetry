#: ../../functions/normalizations/batch_renormalization.rst:3
msgid "Batch Renormalization"
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:1
#: of
msgid "Apply batch renormalization to the input tensor."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:3
#: of
msgid ""
"Batch renormalization corrects the batch statistics toward the running "
"statistics using the clipped factors ``r`` and ``d``, which keeps the "
"train-time behavior close to the inference-time behavior even with small "
"mini-batches."
msgstr ""

#: ../../functions/normalizations/batch_renormalization.rst
#: marquetry.functions.normalization.batch_renormalization.batch_renormalization
#: of
msgid "Parameters"
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:7
#: of
msgid "The input tensor."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:9
#: of
msgid "The scale factor."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:11
#: of
msgid "The shift factor."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:13
#: of
msgid "The running mean which is updated in train mode and used in test mode."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:15
#: of
msgid "The running variance which is updated in train mode and used in test mode."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:17
#: of
msgid ""
"The clipping bound of the std correction factor ``r``. ``1.0`` (default) "
"disables the correction which means the behavior is identical to batch "
"normalization. The paper suggests increasing this gradually from 1 during"
" training."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:22
#: of
msgid ""
"The clipping bound of the mean correction factor ``d``. ``0.0`` (default)"
" disables the correction."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:25
#: of
msgid "The decay rate of the running statistics. Default is 0.9."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:27
#: of
msgid "A small value to prevent division by zero. Default is 1e-15."
msgstr ""

#: marquetry.functions.normalization.batch_renormalization.batch_renormalization:32
#: of
msgid ""
"Generally use case, you can use BatchRenormalization in "
":mod:`marquetry.layers`. The layer component manages gamma, beta, and the"
" running statistics itself."
msgstr ""

